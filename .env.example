# FIDE Service — example environment. Copy to `.env` and fill in secrets.
# NEVER commit a real `.env` with credentials.
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-value
DATABASE_URL=sqlite:///fide.db
# Service-to-service API key presented by Swiss Manager as `X-API-Key`.
# REQUIRED in production: the API fails closed (503) when unset.
FIDE_API_KEY=
# Optional separate admin key for /api/v1/admin/*. When unset, the read
# key (FIDE_API_KEY) also authorizes admin endpoints.
FIDE_ADMIN_KEY=
FIDE_SERVICE_HOST=127.0.0.1
FIDE_SERVICE_PORT=5001
FIDE_DATA_DIRECTORY=./var/fide-data
IMPORT_TIMEOUT_SECONDS=600
IMPORT_BATCH_SIZE=500
# Federations whose multi-period rating history is retained.
# Identity + current-period ratings are stored for ALL federations;
# older periods are pruned for federations NOT listed here.
# Empty value keeps history for every federation.
HISTORY_FEDERATIONS=IRI
# Read-API rate limit per key per minute. 0 disables (tests/local only).
RATE_LIMIT_PER_MINUTE=600
# Rejected-auth budget per client IP per hour (401/403). Over-budget IPs
# get 429 before any key comparison. 0 disables (tests/local only).
AUTH_FAIL_LIMIT_PER_HOUR=120
# Admin upload cap in bytes (staged FIDE ZIPs).
FIDE_UPLOAD_MAX_BYTES=125829120
# Upstream official FIDE download hub (outbound only; API serves local DB).
# HTTPS is the default and must stay unless the host provably cannot use
# it (override loudly here in that case — plain HTTP admits MITM swaps).
FIDE_DOWNLOAD_BASE_URL=https://ratings.fide.com/download/
FIDE_CONNECT_TIMEOUT=10
FIDE_READ_TIMEOUT=30
FIDE_MAX_RETRIES=3
